# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL (requires PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Midtrans Sandbox (server-side keys). Leave empty to run checkout in development mode.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""

# Secret used by Vercel Cron to guard GET /api/cron/cancel-expired.
CRON_SECRET=""
